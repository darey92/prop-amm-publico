# Copy to .env, which git ignores, and run commands with `uv run --env-file .env propamm ...`.

# HyperSync API token: free, from envio.dev under "API tokens". The HyperSync ingestion (W2)
# reads it to fetch weeks of history.
ENVIO_API_TOKEN=

# Optional Base RPC endpoint with your own key. Without it, commands use PublicNode's free one.
# BASE_RPC_URL=
